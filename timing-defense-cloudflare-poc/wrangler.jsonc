{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timing-defense-do-poc",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TimingDefenseRoom"
      }
    ]
  },
  "exports": {
    "TimingDefenseRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "../timing-defense-v011",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/ws/*"
    ]
  }
}
